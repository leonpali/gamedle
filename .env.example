# Postgres connection string (matches docker-compose.yml; use your Neon/Supabase URL in production)
DATABASE_URL=postgres://gamedle:gamedle@localhost:5432/gamedle

# Secret used to sign the anonymous session cookie. At least 32 characters.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=

# IGDB credentials come from a Twitch developer application:
# https://api-docs.igdb.com/#account-creation
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Games with fewer IGDB ratings than this are not imported (keeps search free of obscure titles)
IGDB_MIN_RATING_COUNT=20
# Only games with at least this many ratings can be picked as the daily answer
DAILY_MIN_RATING_COUNT=200
